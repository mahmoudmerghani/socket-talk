// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
}

model User {
  id                      Int                       @id @default(autoincrement())
  username                String                    @unique
  password                String?
  displayName             String
  email                   String?                   @unique
  isVerified              Boolean                   @default(false)
  avatarColor             String
  avatarUrl               String?
  avatarPath              String?
  createdAt               DateTime                  @default(now())
  sessions                Session[]
  oauthAccounts           OauthAccount[]
  messages                Message[]
  createdGroups           Group[]
  conversationMemberships ConversationParticipant[]
  DM1                     DM[]                      @relation("user1")
  DM2                     DM[]                      @relation("user2")
  selfChat                SelfChat?
}

enum OauthProvider {
  GITHUB
}

model OauthAccount {
  providerId String
  provider   OauthProvider
  userId     Int
  user       User          @relation(fields: [userId], references: [id])

  @@id([providerId, provider])
}

model Message {
  id                  Int                       @id @default(autoincrement())
  content             String
  sentAt              DateTime                  @default(now())
  senderId            Int
  sender              User                      @relation(fields: [senderId], references: [id])
  conversationId      Int
  conversation        Conversation              @relation(fields: [conversationId], references: [id])
  lastReadParticipant ConversationParticipant[]
}

enum ConversationType {
  DIRECT
  GROUP
  SELF
}

model Conversation {
  id           Int                       @id @default(autoincrement())
  createdAt    DateTime                  @default(now())
  type         ConversationType
  messages     Message[]
  participants ConversationParticipant[]
  group        Group?
  DM           DM?
  selfChat     SelfChat?
}

model ConversationParticipant {
  userId            Int
  conversationId    Int
  user              User         @relation(fields: [userId], references: [id])
  conversation      Conversation @relation(fields: [conversationId], references: [id])
  lastReadMessageId Int?
  lastReadMessage   Message?     @relation(fields: [lastReadMessageId], references: [id])
  joinedAt          DateTime     @default(now())

  @@id([userId, conversationId])
}

model Group {
  conversationId Int          @id
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  name           String
  avatarColor    String
  avatarUrl      String?
  avatarPath     String?
  creatorId      Int
  creator        User         @relation(fields: [creatorId], references: [id])
}

model DM {
  conversationId Int          @id
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId1        Int
  userId2        Int
  user1          User         @relation(fields: [userId1], references: [id], name: "user1")
  user2          User         @relation(fields: [userId2], references: [id], name: "user2")

  // user1 < user2 should hold to remove order
  @@unique([userId1, userId2])
}

model SelfChat {
  conversationId Int          @id
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         Int          @unique
  user           User         @relation(fields: [userId], references: [id])
}
